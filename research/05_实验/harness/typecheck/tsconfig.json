{
  // Type-checks the plugin against the *real* DSH declarations rather than against mocks.
  //
  // The point of this file is falsification. `plugin.ts` was written from documentation,
  // and the unit tests cannot catch a wrong assumption about a host API because they mock
  // the same assumption. Checking against the shipped .d.ts is the only step that can
  // disagree with the author.
  //
  // Run `npm run typecheck` from this directory. The `vendor/` tree is regenerated by
  // `harness/remote_bundle_types.sh` plus `remote.py get`, so it is not committed.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    // `Bundler` rather than `NodeNext`: the host declarations are reached through a
    // `paths` mapping to a directory, and NodeNext refuses to read a directory's
    // package.json when it arrives that way. NodeNext also cannot find them via
    // node_modules at all, because resolution walks up from the *plugin's* directory
    // (`04_协调插件/...`), never from this harness. Bundler mode honours both the
    // mapping and each package's `exports` conditions, and still accepts the explicit
    // `.ts` import specifiers the runtime needs.
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // The project runs .ts files directly under `node --test`, relying on Node's type
    // stripping. Stripping erases types but cannot transform runtime syntax, so any
    // `enum`, `namespace`, or constructor parameter property would throw at runtime while
    // a conventional type check stays quiet. This flag turns that runtime-only failure
    // into a compile-time one.
    "erasableSyntaxOnly": true,

    // Required because the source imports sibling modules with explicit `.ts` extensions,
    // which is what Node's resolver needs.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "isolatedModules": true,

    // The vendored host declarations are 241 packages of third-party types; errors inside
    // them are not actionable here. Errors from our *use* of them are still reported.
    "skipLibCheck": true,

    // `baseUrl` was removed in TypeScript 7; `paths` entries resolve relative to this file.
    "paths": {
      "@deepseek-ai/*": ["./vendor/@deepseek-ai/*"]
    }
  },
  "include": [
    "../../../04_协调插件/dsh-coord-governor/src/**/*.ts",
    "../../../04_协调插件/dsh-coord-governor/tests/**/*.ts"
  ]
}
